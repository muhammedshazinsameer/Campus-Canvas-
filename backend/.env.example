# Server Port (Render sets this automatically)
PORT=5000

# PostgreSQL Connection Pooling URL (e.g. Supabase port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct PostgreSQL URL (Used for Prisma schema migrations, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Student & Editor Authentication Tokens (Generate a strong 64-char string)
JWT_SECRET="your_production_random_jwt_secret_key_here"

# Editorial Board Master Password (used for Editor Desk sign-in on admin dashboard)
EDITOR_PASSWORD="your_secure_editor_password_here"

# Allowed CORS Origins (Replace with production Vercel URLs when deployed)
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Cloudinary Credentials (Optional: backend falls back to local uploads/ if empty)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
