generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  campusId    String?
  avatarUrl   String?
  role        String       @default("student") // student | editor
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reviews     Submission[] @relation("EditorReviews")
  submissions Submission[] @relation("StudentSubmissions")
}

model Submission {
  id                String          @id @default(uuid())
  title             String
  type              String          // Poetry | Fiction | Essay | Poster | Art | Photography
  category          String
  authorDisplayName String
  textContent       String?         @db.Text
  fileUrl           String?
  filePublicId      String?
  status            String          @default("pending") // pending | approved | rejected
  editorComment     String?         @db.Text
  createdAt         DateTime        @default(now())
  reviewedAt        DateTime?
  authorId          String?
  author            User?           @relation("StudentSubmissions", fields: [authorId], references: [id], onDelete: SetNull)
  reviewerId        String?
  reviewer          User?           @relation("EditorReviews", fields: [reviewerId], references: [id], onDelete: SetNull)
  tags              SubmissionTag[]

  @@index([status])
  @@index([type])
  @@index([category])
}

model Tag {
  id          String          @id @default(uuid())
  name        String          @unique
  submissions SubmissionTag[]
}

model SubmissionTag {
  submissionId String
  tagId        String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([submissionId, tagId])
}
